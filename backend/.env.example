# ============================================================
# 海瞳鱼鉴 SeaPupil · 后端环境变量示例
# 用法：复制本文件为 backend/.env，按需修改
# 所有变量前缀 SEATONG_；不配置 .env 时使用代码内默认值（可跑通）
# ============================================================

# ---- 应用 ----
SEATONG_APP_NAME=海瞳鱼鉴 SeaPupil
SEATONG_DEBUG=true

# ---- 服务 ----
SEATONG_HOST=0.0.0.0
SEATONG_PORT=8000
# 前端开发服务器地址（CORS 白名单），前端改端口时须同步
SEATONG_FRONTEND_ORIGIN=http://localhost:5180

# ---- 数据库（默认 <仓库>/backend/data/seatong.db，一般无需改） ----
# SEATONG_DB_PATH=D:\data\seatong.db

# ---- 安全（生产环境必须换成随机长字符串！生成：python -c "import secrets;print(secrets.token_hex(32))"） ----
SEATONG_JWT_SECRET=change-me-to-a-random-secret-in-production
SEATONG_ACCESS_TOKEN_EXPIRE_MINUTES=120
SEATONG_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- 游客额度 ----
SEATONG_GUEST_QUOTA=3

# ---- 上传限制 ----
SEATONG_MAX_FILE_SIZE_MB=10
SEATONG_BATCH_UPLOAD_LIMIT=9

# ---- 模型路径（默认 <仓库>/ml/models/M1_ood_tuned/best.pt；
#      回滚基线：<仓库>/ml/models/M1_main_224/best.pt） ----
# SEATONG_MODEL_PATH=D:\models\best.pt

# ---- 限流 ----
SEATONG_RATE_LIMIT_PER_MINUTE=60
